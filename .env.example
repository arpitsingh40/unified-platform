# === REQUIRED: AI Provider ===
# Get your key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# === REQUIRED: Security ===
JWT_SECRET=replace-with-random-32-character-secret-string

# === REQUIRED: Database ===
MONGO_URL=mongodb://localhost:27017/smartdecision
DB_NAME=smartdecision

# === REQUIRED: Deployment ===
CORS_ORIGINS=https://yourdomain.com,http://localhost:3000
FRONTEND_BASE_URL=https://yourdomain.com

# ────────────────────────────────────
# OPTIONAL: Execution Runtime (Connect tools for automation)
# ────────────────────────────────────

# Composio Cloud (enables 1,403 tool integrations)
COMPOSIO_API_KEY=

# GitHub (deploy websites, create issues, manage repos)
GITHUB_TOKEN=
GITHUB_OWNER=your-github-username

# Gmail (send emails, email campaigns)
GMAIL_ACCESS_TOKEN=

# Slack (team notifications, alerts)
SLACK_TOKEN=

# Notion (create docs, reports, specs)
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# Stripe (invoices, payments)
STRIPE_API_KEY=

# Vercel (deploy websites)
VERCEL_TOKEN=

# ────────────────────────────────────
# OPTIONAL: Billing
# ────────────────────────────────────

# Zoho Payments (India UPI + cards)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_API_BASE=https://payments.zoho.in/api/v1
ZOHO_WEBHOOK_SECRET=

# Stripe (international fallback)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ────────────────────────────────────
# OPTIONAL: Advanced Configuration
# ────────────────────────────────────

# LLM model selection (defaults shown)
LLM_MODEL=deepseek-v4-flash
LLM_MODEL_ULTRA=deepseek-v4-pro
LLM_MODEL_ANALYTICAL=deepseek-v4-flash
LLM_MODEL_FALLBACK=deepseek-v4-flash

# Credit system
TURN_COST=5
ULTRA_TURN_COST=10
SIGNUP_CREDITS=100

# Disable MCP execution (set to "1" to disable tool execution)
DISABLE_MCP=0

# Plan basis (template for task generation)
PLAN_BASIS=GROWTH
